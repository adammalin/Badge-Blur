{
  "name": "badge-blur",
  "productName": "Badge Blur",
  "version": "0.20.0",
  "private": true,
  "description": "Local-only desktop app for detecting and redacting identification badges.",
  "author": "UT-Battelle LLC",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "prepare:model": "bash scripts/download-grounding-dino-model.sh && bash scripts/download-clip-classifier.sh",
    "prepare:wasm": "node scripts/copy-wasm.mjs",
    "prepare": "npm run prepare:model && npm run prepare:wasm",
    "dev": "vite --host 127.0.0.1",
    "setup": "npm install && npm run build",
    "start": "electron-forge start",
    "start:web": "node scripts/serve.mjs",
    "prepare:icons": "node scripts/generate-app-icons.mjs",
    "build": "npm run prepare:icons && vite build",
    "benchmark:models": "node scripts/benchmark-models.mjs",
    "benchmark:workers": "node scripts/benchmark-model-workers.mjs",
    "test:corner-fit": "node scripts/test-corner-fit.mjs",
    "test:redaction": "node scripts/test-redaction-strength.mjs",
    "test:worker-policy": "node scripts/test-worker-policy.mjs",
    "test:worker-pool": "node scripts/test-worker-pool.mjs",
    "test:classifier-policy": "node scripts/test-classifier-policy.mjs",
    "test:person-guidance": "node scripts/test-person-guidance.mjs",
    "test:run-storage": "node scripts/test-run-storage.mjs",
    "test:run-import": "node scripts/test-run-import.mjs",
    "test:manifest-source": "node scripts/test-manifest-source-recovery.cjs",
    "test:export-folder": "node scripts/test-export-folder.cjs",
    "test:checkpoint": "node scripts/test-checkpoint.mjs",
    "test:thumbnail": "node scripts/test-thumbnail-preview.mjs",
    "test:mask-controls": "node scripts/test-mask-controls.mjs",
    "test:lifecycle": "node scripts/test-server-lifecycle.mjs",
    "test:electron": "npm run build && cross-env BADGE_BLUR_SMOKE_TEST=1 electron-forge start",
    "test:badge-set": "node scripts/evaluate-badge-set.mjs",
    "test:badge-production": "node scripts/evaluate-badge-set.mjs --torso-guided --global-classifier --skip-redaction",
    "package:mac": "npm run package:electron:mac",
    "package:windows": "npm run package:electron:windows",
    "package:windows:installer": "npm run package:electron:windows",
    "package:electron:mac": "npm run build && node scripts/package-electron.mjs mac",
    "package:electron:windows": "npm run build && node scripts/package-electron.mjs windows",
    "package:demo-images": "zsh scripts/package-demo-images.sh",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "electron-squirrel-startup": "1.0.1",
    "exiftool-vendored": "^37.0.0",
    "heic-decode": "^2.1.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "cross-env": "10.1.0",
    "electron": "43.2.0",
    "vite": "7.3.6"
  },
  "overrides": {
    "isbinaryfile": "5.0.7",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=20"
  }
}
